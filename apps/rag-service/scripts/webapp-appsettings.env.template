# Azure Web App app settings template for AIGovernTrustworthyRAGApp
# Fill values from .env.local.L4 before release. Do not commit real secrets here.

WEBSITES_PORT=8000
PORT=8000
LOG_LEVEL=INFO

L4_RAG_APP_NAME=AIGovernTrustworthyRAGApp
L4_RAG_APP_URL=https://aigoverntrustworthyragapp-hchcfae9hpczcrcx.canadaeast-01.azurewebsites.net
L4_RAG_RETRIEVAL_MODE=<from .env.local.L4: L4_RAG_RETRIEVAL_MODE>
L4_RAG_SERVICE_URL=<from .env.local.L4: L4_RAG_SERVICE_URL>   # APIM /rag base URL; UI proxy appends /responses
L4_RAG_LLM_ENDPOINT=<from .env.local.L4: L4_RAG_LLM_ENDPOINT>
L4_RAG_MODEL_NAME=<from .env.local.L4: L4_RAG_MODEL_NAME>
L4_RAG_MODEL_DEPLOYMENT=<from .env.local.L4: L4_RAG_MODEL_DEPLOYMENT>

L4_AOAI_SERVICE_NAME=<from .env.local.L4: L4_AOAI_SERVICE_NAME>
# Optional fallback for older local runs
L4_AOAI_ENDPOINT=<from .env.local.L4: L4_AOAI_ENDPOINT>

L4_OTEL_SERVICE_NAME_RAG_SERVICE=<from .env.local.L4: L4_OTEL_SERVICE_NAME_RAG_SERVICE>
OTEL_SERVICE_NAME=<same value as L4_OTEL_SERVICE_NAME_RAG_SERVICE>
APPLICATIONINSIGHTS_CONNECTION_STRING=<from .env.local.L4: APPLICATIONINSIGHTS_CONNECTION_STRING>

L4_OBSERVABILITY_PACKAGE_NAME=<from .env.local.L4: L4_OBSERVABILITY_PACKAGE_NAME>
L4_OBSERVABILITY_BLOB_STORAGE_ACCOUNT_NAME=<from .env.local.L4: L4_OBSERVABILITY_BLOB_STORAGE_ACCOUNT_NAME>
L4_OBSERVABILITY_BLOB_CONTAINER=<from .env.local.L4: L4_OBSERVABILITY_BLOB_CONTAINER>
L4_OBSERVABILITY_BLOB_PREFIX=<from .env.local.L4: L4_OBSERVABILITY_BLOB_PREFIX>

AZURE_TENANT_ID=<from .env.local.L4: AZURE_TENANT_ID>
AZURE_CLIENT_ID=<from .env.local.L4: L4_RAG_SERVICE_CLIENT_ID>
AZURE_CLIENT_SECRET=<from .env.local.L4: L4_RAG_SERVICE_CLIENT_SECRET>

# Optional mirrors for local/runtime consistency
L4_RAG_SERVICE_CLIENT_ID=<same value as AZURE_CLIENT_ID>
L4_RAG_SERVICE_CLIENT_SECRET=<same value as AZURE_CLIENT_SECRET>
